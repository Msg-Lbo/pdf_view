<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_library_page"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="文件库"
            android:textColor="#172033"
            android:textSize="30sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_source_settings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/source_settings"
            android:padding="10dp"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="扫描本地 PDF，或从远端源下载后自动分组。阅读数据只保存在本机。"
        android:textColor="#667085"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_library_card"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="添加 PDF"
            android:textColor="#172033"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="本地扫描、手动选择，或点击右上角源设置打开远端浏览面板。"
            android:textColor="#667085"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/button_scan"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/scan_local_pdf"
                android:textColor="#2457D6" />

            <Button
                android:id="@+id/button_pick"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_secondary_button"
                android:text="@string/pick_pdf"
                android:textColor="#2457D6" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/text_library_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_library_status"
        android:padding="12dp"
        android:text="@string/empty_library"
        android:textColor="#24406F"
        android:textSize="14sp" />

    <LinearLayout
        android:id="@+id/panel_remote_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_library_card"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_remote_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="远端源"
                android:textColor="#172033"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/button_remote_root"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                android:text="根目录"
                android:textColor="#2457D6" />

            <Button
                android:id="@+id/button_remote_close"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_secondary_button"
                android:text="关闭"
                android:textColor="#2457D6" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_remote_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#667085"
            android:textSize="13sp" />

        <Button
            android:id="@+id/button_remote_download_current"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_primary_button"
            android:text="下载当前目录并自动分组"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_remote_entries"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="10dp"
            android:clipToPadding="false" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/list_pdfs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <Button
        android:id="@+id/button_create_group"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_primary_button"
        android:text="@string/create_group"
        android:textColor="#FFFFFF"
        android:textStyle="bold" />
</LinearLayout>
